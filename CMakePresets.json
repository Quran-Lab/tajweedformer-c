{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows x64, MinGW-w64 GCC (the Core's toolchain); QLCORE_DIR names the Core's folder",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "QLCORE_DIR": "$env{QLCORE_DIR}"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x64 (GCC or clang); QLCORE_DIR names the Core's folder",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QLCORE_DIR": "$env{QLCORE_DIR}"
      }
    }
  ],
  "buildPresets": [
    {"name": "windows-mingw", "configurePreset": "windows-mingw"},
    {"name": "linux", "configurePreset": "linux"}
  ]
}
